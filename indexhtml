<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MR CB YT - Free Fire Achievement Hub</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:Arial,sans-serif;background:#050814;color:#fff;line-height:1.5}
    header{background:#081226;border-bottom:1px solid #18365c;padding:18px 14px;position:sticky;top:0;z-index:10}
    .brand{font-size:25px;font-weight:800;color:#00d9ff;text-align:center}
    .sub{text-align:center;color:#9da8c7;font-size:13px;margin-top:4px}
    nav{display:flex;gap:7px;overflow:auto;margin-top:15px;justify-content:center}
    nav button{background:#0d1a31;color:#fff;border:1px solid #21466f;border-radius:9px;padding:9px 12px;white-space:nowrap}
    nav button:hover{background:#174cff}
    .container{width:92%;max-width:1100px;margin:auto}
    .hero{text-align:center;padding:55px 10px 35px}
    .hero h1{font-size:34px;color:#00d9ff;text-shadow:0 0 18px #006cff}
    .hero p{color:#aab4d0;margin-top:12px}
    .cta{margin-top:20px}
    .btn{background:#174cff;color:#fff;border:0;border-radius:10px;padding:12px 18px;font-weight:700}
    section{padding:28px 0}
    .title{text-align:center;color:#00d9ff;margin-bottom:18px}
    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px}
    .card{background:#0b1122;border:1px solid #193cff;border-radius:14px;padding:18px;box-shadow:0 0 16px rgba(0,120,255,.12)}
    .card h3{color:#00d9ff;margin-bottom:8px}
    .card p{color:#aab4d0}
    .progress{height:10px;background:#17213a;border-radius:20px;overflow:hidden;margin-top:12px}
    .bar{height:100%;width:35%;background:#00d9ff}
    .notice{padding:15px;border:1px solid #7a4cff;border-radius:12px;background:#10102a;color:#ddd;margin-top:15px}
    footer{text-align:center;padding:28px 10px;color:#7f8aa8;border-top:1px solid #18365c;margin-top:30px}
    .hidden{display:none}
    @media(max-width:600px){.hero h1{font-size:27px}nav{justify-content:flex-start}.cards{grid-template-columns:1fr}}
  </style>
</head>
<body>
<header>
  <div class="brand">MR CB YT</div>
  <div class="sub">Free Fire Achievement Hub & Community</div>
  <nav>
    <button onclick="show('home')">Home</button>
    <button onclick="show('achievements')">Achievements</button>
    <button onclick="show('videos')">Videos</button>
    <button onclick="show('updates')">Updates</button>
    <button onclick="show('community')">Community</button>
    <button onclick="show('login')">Login</button>
  </nav>
</header>
<main class="container">
  <section id="home">
    <div class="hero">
      <h1>FREE FIRE ACHIEVEMENT HUB</h1>
      <p>Track achievements, discover videos, follow updates and join the MR CB YT community.</p>
      <div class="cta"><button class="btn" onclick="show('achievements')">View Achievements</button></div>
    </div>
    <div class="cards">
      <div class="card"><h3>140+ Achievements</h3><p>Track your achievement progress.</p></div>
      <div class="card"><h3>Community</h3><p>Connect with other players and share updates.</p></div>
      <div class="card"><h3>Protected Content</h3><p>Premium content can be protected by access sessions.</p></div>
    </div>
  </section>
  <section id="achievements" class="hidden">
    <h2 class="title">Achievements</h2>
    <div class="cards">
      <div class="card"><h3>First Victory</h3><p>Win your first match.</p><div class="progress"><div class="bar" style="width:80%"></div></div></div>
      <div class="card"><h3>Head Hunter</h3><p>Complete the required headshot challenge.</p><div class="progress"><div class="bar" style="width:45%"></div></div></div>
      <div class="card"><h3>Survivor</h3><p>Complete a long survival challenge.</p><div class="progress"><div class="bar" style="width:25%"></div></div></div>
      <div class="card"><h3>Rank Master</h3><p>Reach the required ranked milestone.</p><div class="progress"><div class="bar" style="width:60%"></div></div></div>
    </div>
  </section>
  <section id="videos" class="hidden">
    <h2 class="title">Videos</h2>
    <div class="cards">
      <div class="card"><h3>Public Video 01</h3><p>YouTube video slot — replace with your link.</p></div>
      <div class="card"><h3>Public Video 02</h3><p>YouTube video slot — replace with your link.</p></div>
      <div class="card"><h3>Protected Video</h3><p>Protected-content slot. Full 24-hour authentication requires a backend.</p></div>
    </div>
  </section>
  <section id="updates" class="hidden">
    <h2 class="title">Updates</h2>
    <div class="cards">
      <div class="card"><h3>Latest Hub Update</h3><p>Achievement Hub interface updated.</p></div>
      <div class="card"><h3>Community Update</h3><p>More community content can be added later.</p></div>
    </div>
  </section>
  <section id="community" class="hidden">
    <h2 class="title">Community</h2>
    <div class="cards">
      <div class="card"><h3>MR CB YT Community</h3><p>Share Free Fire achievements, videos and gaming updates.</p></div>
      <div class="card"><h3>Social Links</h3><p>Add your YouTube, Instagram and other links here.</p></div>
    </div>
  </section>
  <section id="login" class="hidden">
    <h2 class="title">Login</h2>
    <div class="card">
      <p style="margin-bottom:12px">Demo login screen. A real secure login needs a backend and database.</p>
      <input id="uid" placeholder="Instagram ID or Free Fire UID" style="width:100%;padding:12px;border-radius:8px;border:1px solid #31547e;background:#07101f;color:#fff;margin-bottom:10px">
      <input type="password" placeholder="Password" style="width:100%;padding:12px;border-radius:8px;border:1px solid #31547e;background:#07101f;color:#fff;margin-bottom:10px">
      <button class="btn" onclick="alert('Demo login only — backend authentication is required for production.')">Login</button>
    </div>
  </section>
</main>
<footer>MR CB YT • Free Fire Achievement Hub & Community</footer>
<script>
function show(id){
  document.querySelectorAll('main section').forEach(s=>s.classList.add('hidden'));
  document.getElementById(id).classList.remove('hidden');
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>
</body>
</html>
